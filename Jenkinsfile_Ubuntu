pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                script {
                    cleanWs()
                    checkout scm
                }
            }
        }
        stage('Install Dependencies and Run Tests') {
            steps {
                script {
                    sh '''
                        docker run --rm -v "$WORKSPACE:/workspace/test_playwright_cucumber" -w /workspace/test_playwright_cucumber mcr.microsoft.com/playwright:v1.44.1-jammy /bin/bash -c "npm install @dotenvx/dotenvx; npm install @playwright/test@1.44.1; npm install; npm list @cucumber/cucumber; npm run test:sandbox:headless"
                    '''
                }
            }
        }
    }
    post {
        always {
                allure includeProperties:
                false,
                jdk: '',
                results: [[path: 'test_playwright_cucumber/allure-results']]
                }
    }
}
